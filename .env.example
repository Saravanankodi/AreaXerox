# Copy to .env.local and fill in. Never commit real values.
# .env.local is gitignored; this template is intentionally committed.

# ---------------------------------------------------------------------------
# Firebase client (safe to expose to the browser — these are public identifiers,
# authorisation is enforced by Firestore/Auth security rules, not by the key)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Browser push (Phase 2) — REQUIRED for FCM
# ---------------------------------------------------------------------------
# Firebase console -> Project settings -> Cloud Messaging -> Web configuration
# -> "Web Push certificate pair" -> Generate new key pair. Copy the "Key pair"
# value. This is a public key; it is safe to expose, and it is NOT the private
# key. Without it, /settings reports push as "not configured" and no device can
# subscribe.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ---------------------------------------------------------------------------
# Firebase Admin (server only — never prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------------
# Full service-account JSON on one line, with escaped newlines in the
# private_key. Required for the notification API, push sending, and the payment
# webhooks. If unset the code falls back to Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT=

# ---------------------------------------------------------------------------
# Cloudinary (document upload)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Set PAYMENT_GATEWAY to "razorpay" or "cashfree" to pick the active gateway.
PAYMENT_GATEWAY=
NEXT_PUBLIC_PAYMENT_GATEWAY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cashfree verifies its webhook HMAC with the same secret key, so there is no
# separate webhook secret variable.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=
NEXT_PUBLIC_CASHFREE_ENVIRONMENT=

# Percentage of each order paid out to the shop; the remainder is platform
# commission.
PLATFORM_COMMISSION_PERCENT=
